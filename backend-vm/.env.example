# Firebase Admin SDK (from Google Cloud Console)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"sightline-prod","private_key":"-----BEGIN RSA..."}

# Organization ID (identifies which company this worker serves)
ORG_ID=company-123

# GitHub App (from GitHub Developer Settings)
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----
GITHUB_APP_ID=123456
# Dashboard-to-VM webhook shared secret (HMAC-SHA256).
# IMPORTANT: this MUST hold the SAME value as the Vercel server-side
# WEBHOOK_SECRET — the dashboard signs each job payload with it and the VM
# verifies the signature, so a mismatch fails EVERY job with 401.
# (GITHUB_WEBHOOK_SECRET is a deprecated alias for this same value, kept only
# for backwards compatibility with already-deployed VMs.)
WEBHOOK_SECRET=your-webhook-secret

# LLM API Keys
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
ANTHROPIC_API_KEY=sk-ant-...

# Monitoring & Alerts
TELEGRAM_BOT_TOKEN=123456:ABCdefGHIjklmnoPQRstuvWXYZ...
TELEGRAM_CHAT_ID=987654321

# Optional: GEO Optimizer CLI path (for local audits)
GEO_OPTIMIZER_PATH=/usr/local/bin/geo

# Hermes Configuration
VM_POLLING_INTERVAL_SECONDS=60
MAX_RETRIES=3
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_JOBS=5
