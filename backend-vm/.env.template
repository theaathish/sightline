# Copy this to .env and fill in your actual values

# Firebase Admin SDK (from Firebase Console → Service Accounts)
FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"sightline-9d056","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@sightline-9d056.iam.gserviceaccount.com",...}'

# Organization ID (unique identifier for your first customer)
ORG_ID=test-company

# GitHub App (from GitHub Settings → Developer Settings → GitHub Apps)
GITHUB_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----
... (paste entire private key from downloaded PEM file)
-----END RSA PRIVATE KEY-----'
GITHUB_APP_ID=123456  # Your app ID from GitHub
# Dashboard-to-VM webhook shared secret (HMAC-SHA256).
# IMPORTANT: this MUST hold the SAME value as the Vercel server-side
# WEBHOOK_SECRET — the dashboard signs each job payload with it and the VM
# verifies the signature, so a mismatch fails EVERY job with 401.
# (GITHUB_WEBHOOK_SECRET is a deprecated alias for this same value, kept only
# for backwards compatibility with already-deployed VMs.)
WEBHOOK_SECRET=your-random-secret-string

# LLM API Keys
OPENAI_API_KEY=sk-proj-...  # From platform.openai.com
GEMINI_API_KEY=AIza...  # From aistudio.google.com
PERPLEXITY_API_KEY=pplx-...  # From perplexity.ai
ANTHROPIC_API_KEY=sk-ant-...  # From console.anthropic.com

# Telegram (optional - for error alerts)
# Create bot: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=987654321  # Your chat ID (use @userinfobot)

# Configuration
VM_POLLING_INTERVAL_SECONDS=60
MAX_RETRIES=3
LOG_LEVEL=INFO
