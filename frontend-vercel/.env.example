# Copy to .env for local dev. In production, set these in Vercel.
# The webhook shared secret has NO public variable: it lives only in the
# server environment below (see README.md "Job submission security").

# --- Public Firebase client config (VITE_ = shipped to the browser, safe) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sightline-9d056.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sightline-9d056
VITE_FIREBASE_STORAGE_BUCKET=sightline-9d056.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- VM worker webhook (public URL is fine; it is useless without the secret) ---
VITE_WEBHOOK_URL=https://your-vm:8000/webhook/job

# --- Server-only secrets (read via process.env on the TanStack Start server) ---
WEBHOOK_SECRET=
