# Firebase Admin SDK (from Google Cloud Console)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"sightline-prod","private_key":"-----BEGIN RSA..."}

# Organization ID (identifies which company this worker serves)
ORG_ID=company-123

# GitHub App (from GitHub Developer Settings)
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# LLM API Keys
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
ANTHROPIC_API_KEY=sk-ant-...

# Monitoring & Alerts
TELEGRAM_BOT_TOKEN=123456:ABCdefGHIjklmnoPQRstuvWXYZ...
TELEGRAM_CHAT_ID=987654321

# Optional: GEO Optimizer CLI path (for local audits)
GEO_OPTIMIZER_PATH=/usr/local/bin/geo

# Hermes Configuration
VM_POLLING_INTERVAL_SECONDS=60
MAX_RETRIES=3
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_JOBS=5
